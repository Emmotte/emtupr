rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidProject(data) {
      return data.keys().hasAll(['title', 'category', 'description', 'isPublic', 'createdAt']) &&
             data.keys().size() <= 6 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 50 &&
             data.description is string && data.description.size() > 0 && data.description.size() <= 500 &&
             data.isPublic is bool &&
             data.link is string &&
             data.createdAt is timestamp;
    }

    match /projects/{projectId} {
      allow get: if isValidId(projectId) && existing().isPublic == true;
      allow list: if resource.data.isPublic == true;
      allow create: if isSignedIn() && isValidId(projectId) && isValidProject(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && isValidId(projectId) && isValidProject(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'description', 'link', 'isPublic']) && incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && isValidId(projectId);
    }
  }
}
